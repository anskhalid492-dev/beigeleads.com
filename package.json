{
  "name": "beigeleads",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply beigeleads --local",
    "db:migrate:remote": "wrangler d1 migrations apply beigeleads --remote",
    "db:seed:local": "wrangler d1 execute beigeleads --local --file=drizzle/seed.sql",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@noble/hashes": "2.4.0",
    "@opennextjs/cloudflare": "^1.20.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-drag-handle-react": "3.34.0",
    "@tiptap/extension-image": "3.34.0",
    "@tiptap/extension-placeholder": "3.34.0",
    "@tiptap/extension-table": "3.34.0",
    "@tiptap/extension-text-align": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fflate": "0.8.2",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "5.1.0",
    "wrangler": "^4.163.0"
  }
}
